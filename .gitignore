# --- 원본 데이터 / 산출물 (대용량, git에 올리지 않음) ---
data/*
!data/.gitkeep
outputs/*
!outputs/.gitkeep

# --- 데이터 확장자 (저장소 어디에 있든 커밋 방지) ---
*.csv
*.csv.gz
*.parquet
*.gpickle
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.html

# --- Python ---
__pycache__/
*.py[cod]
*.pkl
*.h5
*.joblib
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- 환경변수 / 시크릿 ---
.env
*.key

# --- OS / 에디터 ---
.DS_Store
.vscode/
.idea/

# --- Streamlit ---
.streamlit/secrets.toml
